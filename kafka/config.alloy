import.file "grafana_cloud" {
	filename = sys.env("GC_DESTINATIONS_FILE")
}

grafana_cloud.logs "default" {}
livedebugging {
  enabled = true
}

loki.source.kafka "kafka" {
  brokers  = ["kafka:9092"]
  topics   = ["alloy-logs"]
  group_id = "alloy-logs"
  assignor = "range"
  version  = "3.8.0"
  labels   = {
    source    = "kafka",
    component = "loki.source.kafka",
  }
  use_incoming_timestamp = true
  forward_to             = [loki.process.log_data.receiver]

  // Lab Kafka has no auth. Production alternatives from the component docs:
  // authentication {
  //   type = "sasl"
  //   sasl_config {
  //     mechanism = "PLAIN"
  //     user      = sys.env("KAFKA_USER")
  //     password  = sys.env("KAFKA_PASSWORD")
  //     use_tls   = true
  //   }
  // }
  // authentication {
  //   type = "ssl"
  //   tls_config {
  //     ca_file   = "/etc/alloy/kafka-ca.crt"
  //     cert_file = "/etc/alloy/kafka-client.crt"
  //     key_file  = "/etc/alloy/kafka-client.key"
  //   }
  // }
}

loki.process "log_data" {
  forward_to = [grafana_cloud.logs.default.receiver]


  stage.json {
    drop_malformed = true
    expressions = {
      level = "",
      msg   = "",
      app   = "app",
    }
  }

  stage.json {
    source = "app"
    expressions = {
      app_name    = "name",
      app_version = "version",
    }
  }

  stage.template {
    source   = "new_json"
    template = "{\"level\":\"{{ .level }}\",\"msg\":\"{{ .msg }}\",\"app_name\":\"{{ .app_name }}\",\"app_version\":\"{{ .app_version }}\"}"

  }

  stage.output {
    source = "new_json"
  }
 

  
}


