import.file "grafana_cloud" {
	filename = sys.env("GC_DESTINATIONS_FILE")
}

grafana_cloud.otlp "default" {}
livedebugging {
	enabled = true
}

// Receive OTel traces from the demo app
otelcol.receiver.otlp "default" {
	http { }

	grpc { }

	output {
		traces = [otelcol.processor.batch.default.input]
	}
}

// Batch traces for efficiency
otelcol.processor.batch "default" {
	output {
		traces = [
			otelcol.connector.spanmetrics.default.input,
			grafana_cloud.otlp.default.input,
		]
	}
}

// Generate RED metrics from spans
otelcol.connector.spanmetrics "default" {
	histogram {
		explicit { }
	}

	dimension {
		name = "http.method"
	}

	dimension {
		name = "http.status_code"
	}

	metrics_flush_interval = "5s"

	output {
		metrics = [grafana_cloud.otlp.default.input]
	}
}

