import.file "grafana_cloud" {
	filename = sys.env("GC_DESTINATIONS_FILE")
}

grafana_cloud.metrics "default" {}
grafana_cloud.logs "default" {}
// ####################################
// Windows Server Metrics Configuration
// ####################################

prometheus.exporter.windows "default" {
  enabled_collectors = ["cpu","cs","logical_disk","net","os","service","system", "memory", "scheduled_task", "tcp"]
}

// Configure a prometheus.scrape component to collect windows metrics.
prometheus.scrape "example" {
  targets         = prometheus.exporter.windows.default.targets
  scrape_interval = "1m"
  forward_to      = [grafana_cloud.metrics.default.receiver]
}


// ####################################
// Windows Server Logs Configuration
// ####################################

loki.source.windowsevent "application"  {
    eventlog_name = "Application"
    use_incoming_timestamp = true
    forward_to = [loki.process.endpoint.receiver]
}

loki.source.windowsevent "System"  {
    eventlog_name = "System"
    use_incoming_timestamp = true
    forward_to = [loki.process.endpoint.receiver]
}

loki.process "endpoint" {
  forward_to = [grafana_cloud.logs.default.receiver]
  stage.json {
      expressions = {
          message = "",
          Overwritten = "",
          source = "",
          computer = "",
          eventRecordID = "",
          channel = "",
          component_id = "",
          execution = "",
      }
  }

  // Extract nested fields from the "execution" object (e.g. processId, processName).
  stage.json {
      source = "execution"
      expressions = {
          processId = "",
          processName = "",
      }
  }

  stage.structured_metadata {
      values = {
          "eventRecordID" = "",
          "channel" = "",
          "component_id" = "",
          "execution_processId" = "processId",
          "execution_processName" = "processName",
      }
  }

  stage.eventlogmessage {
      source = "message"
      overwrite_existing = true
  }

  stage.labels {
      values = {
          "service_name" = "source",
      }
}

stage.output {
    source = "message"
}

}



livedebugging{}