// MySQL metrics → Grafana Cloud
// job label matches the Cloud MySQL integration dashboard.

import.file "grafana_cloud" {
	filename = sys.env("GC_DESTINATIONS_FILE")
}

livedebugging {
	enabled = true
}

grafana_cloud.metrics "default" {}

prometheus.exporter.mysql "integrations_mysqld_exporter" {
	data_source_name = "root:alloy@(mysql:3306)/"
}

discovery.relabel "integrations_mysqld_exporter" {
	targets = prometheus.exporter.mysql.integrations_mysqld_exporter.targets

	rule {
		target_label = "job"
		replacement  = "integrations/mysqld_exporter"
	}

	rule {
		target_label = "instance"
		replacement  = "mysql-monitoring"
	}
}

prometheus.scrape "integrations_mysqld_exporter" {
	targets         = discovery.relabel.integrations_mysqld_exporter.output
	forward_to      = [grafana_cloud.metrics.default.receiver]
	// 1m matches Grafana Cloud's 1 data-point-per-minute billing assumption.
	scrape_interval = "1m"
}
