// Alloy pipeline cookbook: labels, relabel, keep/drop filters.
//
// This is collector-side shaping (you decide the rules). It is not Adaptive
// Telemetry — Adaptive applies usage-based rules in Grafana Cloud after ingest.
//
// Inspect every stage in the Alloy UI (http://localhost:12345) with live debugging.

import.file "grafana_cloud" {
	filename = sys.env("GC_DESTINATIONS_FILE")
}

grafana_cloud.metrics "default" {}
grafana_cloud.logs    "default" {}

livedebugging {
	enabled = true
}

// ---------------------------------------------------------------------------
// Metrics: discovery.relabel → scrape → prometheus.relabel → Cloud
// ---------------------------------------------------------------------------

// Attach stable target labels before scrape. These become series labels.
discovery.relabel "generator" {
	targets = [{
		__address__ = "generator:8080",
	}]

	rule {
		target_label = "job"
		replacement  = "alloy_pipeline_patterns"
	}

	rule {
		target_label = "instance"
		replacement  = "generator"
	}

	rule {
		target_label = "env"
		replacement  = "lab"
	}
}

prometheus.scrape "generator" {
	targets         = discovery.relabel.generator.output
	forward_to      = [prometheus.relabel.shaped.receiver]
	scrape_interval = "1m"
}

// prometheus.relabel actions from the Alloy reference:
//   keep / drop / keepequal / dropequal
//   labeldrop / labelkeep / labelmap
//   replace / lowercase / uppercase / hashmod
prometheus.relabel "shaped" {
	forward_to = [grafana_cloud.metrics.default.receiver]

	rule {
		source_labels = ["__name__"]
		regex         = "http_requests_total|app_up"
		action        = "keep"
	}

	rule {
		regex  = "request_id|user_id"
		action = "labeldrop"
	}

	rule {
		source_labels = ["route"]
		regex         = "(/api/(?:orders|users))/[0-9]+"
		target_label  = "route"
		replacement   = "$1/:id"
		action        = "replace"
	}

	rule {
		source_labels = ["method"]
		target_label  = "http_method"
		action        = "replace"
	}

	rule {
		regex  = "method"
		action = "labeldrop"
	}

	rule {
		source_labels = ["http_method"]
		target_label  = "http_method"
		action        = "lowercase"
	}

	rule {
		source_labels = ["instance"]
		target_label  = "shard"
		modulus       = 4
		action        = "hashmod"
	}

	rule {
		target_label = "pipeline"
		replacement  = "alloy_relabel"
	}

	rule {
		target_label = "team"
		replacement  = "platform"
	}

	// Allowlist remaining labels. Must include __name__ or series become unnamed.
	rule {
		regex  = "__name__|job|instance|env|route|http_method|status|pipeline|team|shard"
		action = "labelkeep"
	}
}

// ---------------------------------------------------------------------------
// Logs: file tail → loki.process → Cloud
// ---------------------------------------------------------------------------

local.file_match "app" {
	path_targets = [{
		__path__ = "/logs/app.log",
		job      = "alloy_pipeline_patterns",
	}]
	sync_period = "5s"
}

loki.source.file "app" {
	targets       = local.file_match.app.targets
	forward_to    = [loki.process.shaped.receiver]
	tail_from_end = true
}

// loki.process stages from the Alloy reference (subset this generator hits):
//   json, timestamp, drop, replace, sampling, limit, metrics,
//   static_labels, labels, structured_metadata, match, output
loki.process "shaped" {
	forward_to = [grafana_cloud.logs.default.receiver]

	stage.json {
		expressions = {
			ts         = "ts",
			level      = "level",
			method     = "method",
			path       = "path",
			status     = "status",
			request_id = "request_id",
			msg        = "msg",
			service    = "service",
		}
	}

	stage.timestamp {
		source = "ts"
		format = "RFC3339"
	}

	stage.drop {
		source     = "path"
		expression = "^/(health|ready)$"
	}

	stage.drop {
		source     = "level"
		expression = "debug"
	}

	stage.replace {
		expression = "(/api/(?:orders|users))/[0-9]+"
		source     = "path"
		replace    = "$1/:id"
	}

	// Keep all errors; sample 50% of remaining info lines (docs: rate in [0,1]).
	stage.match {
		selector = `{level="info"}`

		stage.sampling {
			rate                = 0.5
			drop_counter_reason = "info_sampling"
		}
	}

	stage.limit {
		rate  = 20
		burst = 40
		drop  = true
	}

	stage.metrics {
		metric.counter {
			name        = "shaped_log_lines_total"
			description = "log lines after drop/sample/limit"
			prefix      = "alloy_pipeline_"
			match_all   = true
			action      = "inc"
		}
	}

	stage.static_labels {
		values = {
			env      = "lab",
			pipeline = "alloy_process",
			team     = "platform",
		}
	}

	stage.labels {
		values = {
			level   = "",
			method  = "",
			status  = "",
			service = "",
		}
	}

	stage.structured_metadata {
		values = {
			request_id = "",
			path       = "",
		}
	}

	stage.match {
		selector = `{level="error"}`

		stage.static_labels {
			values = {
				alert_worthy = "true",
			}
		}
	}

	stage.output {
		source = "msg"
	}
}

// stage.metrics exposes counters on Alloy's /metrics. Scrape them separately
// so prometheus.relabel.shaped's keep-list does not drop them.
prometheus.scrape "process_metrics" {
	targets = [{
		__address__ = "127.0.0.1:12345",
		job         = "alloy_pipeline_patterns",
	}]
	forward_to      = [prometheus.relabel.process_metrics.receiver]
	scrape_interval = "1m"
}

prometheus.relabel "process_metrics" {
	forward_to = [grafana_cloud.metrics.default.receiver]

	rule {
		source_labels = ["__name__"]
		regex         = "alloy_pipeline_shaped_log_lines_total"
		action        = "keep"
	}
}
