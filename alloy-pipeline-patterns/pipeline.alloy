// Fleet Management pipeline body — paste into a custom pipeline, or splice
// the rules into an integration template (Postgres, Linux Node, …).
//
// There is no Cloud integration for "relabel cookbook". This is the paste.
// Do not include remotecfg or remote_write. Fleet appends destinations.
//
// Wire-up: point your prometheus.scrape forward_to at prometheus.relabel.shaped
// and your loki.source.* forward_to at loki.process.shaped. Then this pipeline
// writes to the Fleet-injected destinations.

prometheus.relabel "shaped" {
	forward_to = [prometheus.remote_write.metrics_service.receiver]

	rule {
		source_labels = ["__name__"]
		regex         = "http_requests_total|app_up"
		action        = "keep"
	}

	rule {
		regex  = "request_id|user_id"
		action = "labeldrop"
	}

	rule {
		source_labels = ["route"]
		regex         = "(/api/(?:orders|users))/[0-9]+"
		target_label  = "route"
		replacement   = "$1/:id"
		action        = "replace"
	}

	rule {
		source_labels = ["method"]
		target_label  = "http_method"
		action        = "replace"
	}

	rule {
		regex  = "method"
		action = "labeldrop"
	}

	rule {
		source_labels = ["http_method"]
		target_label  = "http_method"
		action        = "lowercase"
	}

	rule {
		source_labels = ["instance"]
		target_label  = "shard"
		modulus       = 4
		action        = "hashmod"
	}

	rule {
		target_label = "pipeline"
		replacement  = "alloy_relabel"
	}

	rule {
		regex  = "__name__|job|instance|env|route|http_method|status|pipeline|team|shard"
		action = "labelkeep"
	}
}

loki.process "shaped" {
	forward_to = [loki.write.grafana_cloud_loki.receiver]

	stage.json {
		expressions = {
			ts         = "ts",
			level      = "level",
			method     = "method",
			path       = "path",
			status     = "status",
			request_id = "request_id",
			msg        = "msg",
			service    = "service",
		}
	}

	stage.timestamp {
		source = "ts"
		format = "RFC3339"
	}

	stage.drop {
		source     = "path"
		expression = "^/(health|ready)$"
	}

	stage.drop {
		source     = "level"
		expression = "debug"
	}

	stage.replace {
		expression = "(/api/(?:orders|users))/[0-9]+"
		source     = "path"
		replace    = "$1/:id"
	}

	stage.match {
		selector = `{level="info"}`

		stage.sampling {
			rate                = 0.5
			drop_counter_reason = "info_sampling"
		}
	}

	stage.limit {
		rate  = 20
		burst = 40
		drop  = true
	}

	stage.static_labels {
		values = {
			pipeline = "alloy_process",
		}
	}

	stage.labels {
		values = {
			level   = "",
			method  = "",
			status  = "",
			service = "",
		}
	}

	stage.structured_metadata {
		values = {
			request_id = "",
			path       = "",
		}
	}

	stage.match {
		selector = `{level="error"}`

		stage.static_labels {
			values = {
				alert_worthy = "true",
			}
		}
	}

	stage.output {
		source = "msg"
	}
}
