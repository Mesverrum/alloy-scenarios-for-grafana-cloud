import.file "grafana_cloud" {
	filename = sys.env("GC_DESTINATIONS_FILE")
}

grafana_cloud.otlp "default" {}
/*
 * Alloy Configuration for Sofa Delivery Trace Demo
 */

// Receive OpenTelemetry traces
otelcol.receiver.otlp "default" {
  http {}
  grpc {}

  output {
    traces = [otelcol.processor.batch.default.input]
  }
}

// Batch processor to improve performance
otelcol.processor.batch "default" {
  output {
    traces = [grafana_cloud.otlp.default.input]
  }
}


// Send traces to Tempo

livedebugging {
  enabled = true
} 