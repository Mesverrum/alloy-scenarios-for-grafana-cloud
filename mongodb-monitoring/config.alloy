// MongoDB metrics → Grafana Cloud
// job label matches the Cloud MongoDB integration dashboard.

import.file "grafana_cloud" {
	filename = sys.env("GC_DESTINATIONS_FILE")
}

livedebugging {
	enabled = true
}

grafana_cloud.metrics "default" {}

prometheus.exporter.mongodb "integrations_mongodb_exporter" {
	mongodb_uri     = "mongodb://mongo:27017/"
	direct_connect  = true
	compatible_mode = true
	collect_all     = true
}

discovery.relabel "integrations_mongodb_exporter" {
	targets = prometheus.exporter.mongodb.integrations_mongodb_exporter.targets

	rule {
		target_label = "job"
		replacement  = "integrations/mongodb_exporter"
	}

	rule {
		target_label = "instance"
		replacement  = "mongodb-monitoring"
	}
}

prometheus.scrape "integrations_mongodb_exporter" {
	targets         = discovery.relabel.integrations_mongodb_exporter.output
	forward_to      = [grafana_cloud.metrics.default.receiver]
	// 1m matches Grafana Cloud's 1 data-point-per-minute billing assumption.
	scrape_interval = "1m"
}
