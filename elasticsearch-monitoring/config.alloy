// Elasticsearch metrics → Grafana Cloud

import.file "grafana_cloud" {
	filename = sys.env("GC_DESTINATIONS_FILE")
}

livedebugging {
	enabled = true
}

grafana_cloud.metrics "default" {}

prometheus.exporter.elasticsearch "integrations_elasticsearch" {
	address = "http://elasticsearch:9200"
}

discovery.relabel "integrations_elasticsearch" {
	targets = prometheus.exporter.elasticsearch.integrations_elasticsearch.targets

	rule {
		target_label = "job"
		replacement  = "integrations/elasticsearch"
	}

	rule {
		target_label = "instance"
		replacement  = "elasticsearch-monitoring"
	}
}

prometheus.scrape "integrations_elasticsearch" {
	targets         = discovery.relabel.integrations_elasticsearch.output
	forward_to      = [grafana_cloud.metrics.default.receiver]
	// 1m matches Grafana Cloud's 1 data-point-per-minute billing assumption.
	scrape_interval = "1m"
}
