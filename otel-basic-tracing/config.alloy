import.file "grafana_cloud" {
	filename = sys.env("GC_DESTINATIONS_FILE")
}

grafana_cloud.otlp "default" {}
/*
 * Alloy Configuration for OpenTelemetry Trace Collection
 */

otelcol.receiver.otlp "default" {
  http {}
  grpc {}

  output {
    traces = [otelcol.processor.filter.drop_probes.input]
  }
}

// Head filter (per-span). For whole-trace keep/drop, use otel-tail-sampling.
otelcol.processor.filter "drop_probes" {
  error_mode = "ignore"

  traces {
    span = [
      `attributes["http.target"] == "/health"`,
      `attributes["http.target"] == "/ready"`,
      `attributes["http.route"] == "/health"`,
      `attributes["http.route"] == "/ready"`,
    ]
  }

  output {
    traces = [otelcol.processor.batch.default.input]
  }
}

otelcol.processor.batch "default" {
  output {
    traces = [grafana_cloud.otlp.default.input]
  }
}

