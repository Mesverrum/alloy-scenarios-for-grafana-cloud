// Blackbox HTTP probes → Grafana Cloud
// Probes the local nginx demo and grafana.com (no local Prometheus).

import.file "grafana_cloud" {
	filename = sys.env("GC_DESTINATIONS_FILE")
}

livedebugging {
	enabled = true
}

grafana_cloud.metrics "default" {}

prometheus.exporter.blackbox "integrations_blackbox" {
	config = `
modules:
  http_2xx:
    prober: http
    timeout: 5s
    http:
      preferred_ip_protocol: ip4
      valid_http_versions: ["HTTP/1.1", "HTTP/2.0"]
  tcp_connect:
    prober: tcp
    timeout: 5s
`

	target {
		name    = "nginx"
		address = "http://nginx:80"
		module  = "http_2xx"
	}

	target {
		name    = "nginx_tcp"
		address = "nginx:80"
		module  = "tcp_connect"
	}

	target {
		name    = "grafana_com"
		address = "https://grafana.com"
		module  = "http_2xx"
	}
}

discovery.relabel "integrations_blackbox" {
	targets = prometheus.exporter.blackbox.integrations_blackbox.targets

	rule {
		target_label = "job"
		replacement  = "integrations/blackbox"
	}
}

prometheus.scrape "integrations_blackbox" {
	targets         = discovery.relabel.integrations_blackbox.output
	forward_to      = [grafana_cloud.metrics.default.receiver]
	// 1m matches Grafana Cloud's 1 data-point-per-minute billing assumption.
	scrape_interval = "1m"
}
