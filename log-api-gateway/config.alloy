import.file "grafana_cloud" {
	filename = sys.env("GC_DESTINATIONS_FILE")
}

grafana_cloud.logs "default" {}
livedebugging {
	enabled = true
}

// Accept logs via Loki push API - acts as a centralized log gateway
loki.source.api "default" {
	http {
		listen_address = "0.0.0.0"
		listen_port    = 3500
	}

	forward_to = [loki.process.enrich.receiver]
}

// Enrich logs with gateway metadata
loki.process "enrich" {
	forward_to = [grafana_cloud.logs.default.receiver]

	stage.static_labels {
		values = {
			"gateway" = "alloy",
		}
	}
}

