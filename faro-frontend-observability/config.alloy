import.file "grafana_cloud" {
	filename = sys.env("GC_DESTINATIONS_FILE")
}

grafana_cloud.logs "default" {}
livedebugging {
	enabled = true
}

// Receive frontend telemetry from the Faro Web SDK
faro.receiver "default" {
	server {
		listen_address = "0.0.0.0"
		listen_port    = 12347

		cors_allowed_origins = ["*"]
	}

	output {
		logs = [grafana_cloud.logs.default.receiver]
	}
}

