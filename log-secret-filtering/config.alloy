import.file "grafana_cloud" {
	filename = sys.env("GC_DESTINATIONS_FILE")
}

grafana_cloud.logs "default" {}
livedebugging {
	enabled = true
}

local.file_match "app_logs" {
	path_targets = [{"__path__" = "/tmp/logs/*.log", "job" = "secret-app"}]
	sync_period  = "5s"
}

loki.source.file "log_scrape" {
	targets       = local.file_match.app_logs.targets
	forward_to    = [loki.secretfilter.default.receiver]
	tail_from_end = true
}

// Redact secrets from log lines before sending to Loki.
// Built-in Gitleaks patterns. Alloy v1.17 supports redact_with; later docs also
// mention types / allowlist / include_generic — uncomment those on a newer image.
loki.secretfilter "default" {
	forward_to = [grafana_cloud.logs.default.receiver]

	redact_with = "<REDACTED:$SECRET_NAME>"
	// types = ["aws", "github", "slack"]
	// allowlist = ["(?i)user_id=\\d+"]
}

