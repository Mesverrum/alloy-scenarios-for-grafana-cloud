// NGINX access/error logs + stub_status metrics → Grafana Cloud

import.file "grafana_cloud" {
	filename = sys.env("GC_DESTINATIONS_FILE")
}

livedebugging {
	enabled = true
}

grafana_cloud.metrics "default" {}
grafana_cloud.logs "default" {}

local.file_match "nginx" {
	path_targets = [
		{
			__path__ = "/var/log/nginx-data/access.log",
			job      = "integrations/nginx",
			log_type = "access",
		},
		{
			__path__ = "/var/log/nginx-data/error.log",
			job      = "integrations/nginx",
			log_type = "error",
		},
	]
	sync_period = "5s"
}

loki.source.file "nginx" {
	targets       = local.file_match.nginx.targets
	forward_to    = [loki.process.nginx.receiver]
	tail_from_end = true
}

loki.process "nginx" {
	stage.match {
		selector = "{log_type=\"access\"}"

		stage.regex {
			expression = `^(?P<remote_addr>\S+) - (?P<remote_user>\S+) \[(?P<time_local>[^\]]+)\] "(?P<method>\S+) (?P<path>\S+) [^"]+" (?P<status>\d+) (?P<bytes_sent>\d+)`
		}

		stage.labels {
			values = {
				method = "",
				status = "",
			}
		}
	}

	forward_to = [grafana_cloud.logs.default.receiver]
}

prometheus.scrape "integrations_nginx" {
	targets = [{
		__address__ = "nginx-exporter:9113",
		job         = "integrations/nginx",
	}]
	forward_to = [grafana_cloud.metrics.default.receiver]
	// 1m matches Grafana Cloud's 1 data-point-per-minute billing assumption.
	scrape_interval = "1m"
}
