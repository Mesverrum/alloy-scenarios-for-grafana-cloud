// Alloy as blackbox prober + Probe CR scraper for the Prometheus Operator.
// Deploy with the steps in README.md. Credentials come from the grafana-cloud Secret.

livedebugging {
  enabled = true
}

prometheus.exporter.blackbox "blackbox_exporter" {
  config = "{ modules: { http_2xx: { prober: http, timeout: 5s } } }"
}

prometheus.operator.probes "blackbox" {
  namespaces = ["testns"]
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]
}

prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = sys.env("GC_PROM_URL")

    basic_auth {
      username = sys.env("GC_PROM_USER")
      password = sys.env("GC_TOKEN")
    }
  }
}
