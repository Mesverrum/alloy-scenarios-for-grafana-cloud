// SNMP if_mib walk of the local snmpd demo → Grafana Cloud

import.file "grafana_cloud" {
	filename = sys.env("GC_DESTINATIONS_FILE")
}

livedebugging {}

grafana_cloud.metrics "default" {}

prometheus.exporter.snmp "integrations_snmp" {
	config_file = "/etc/alloy/snmp.yml"

	target "snmpd" {
		address     = "snmpd"
		module      = "if_mib"
		auth        = "public_v2"
		walk_params = "default"
		labels = {
			device = "snmpd",
		}
	}

	walk_param "default" {
		retries = "2"
		timeout = "30s"
	}
}

discovery.relabel "integrations_snmp" {
	targets = prometheus.exporter.snmp.integrations_snmp.targets

	rule {
		target_label = "job"
		replacement  = "integrations/snmp"
	}
}

prometheus.scrape "integrations_snmp" {
	targets    = discovery.relabel.integrations_snmp.output
	forward_to = [grafana_cloud.metrics.default.receiver]
	// 1m matches Grafana Cloud's 1 data-point-per-minute billing assumption.
	scrape_interval = "1m"
}
