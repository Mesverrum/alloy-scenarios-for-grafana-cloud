# Copy to .env in this directory and fill in your Grafana Cloud stack.
#   PowerShell: Copy-Item .env.sample .env
#   bash:       cp .env.sample .env
#
# Do not commit .env. It is gitignored.
#
# Where to get values:
#   Stack overview: Grafana Cloud portal → your stack
#   OTLP endpoints:  https://grafana.com/orgs/<org>/stacks/<stack-id>/otlp-info
#   Access policy:   Grafana Cloud portal → Security → Access Policies
#     Create a token with metrics:write, logs:write, traces:write, profiles:write
#   gcx (after `gcx login`): gcx cloud stacks get <stack-slug>
#
# Native Alloy on Windows/Linux (Docker Compose sets this inside the container):
# GC_DESTINATIONS_FILE=C:\path\to\alloy-scenarios-for-grafana-cloud\_cloud\destinations.alloy

# Cloud Grafana UI (printed by run-example scripts)
GC_GRAFANA_URL=https://<stack>.grafana.net

# Metrics (Mimir / Prometheus remote write)
GC_PROM_URL=https://prometheus-prod-XX.grafana.net/api/prom/push
GC_PROM_USER=<metrics instance id>

# Logs (Loki)
GC_LOKI_URL=https://logs-prod-XX.grafana.net/loki/api/v1/push
GC_LOKI_USER=<logs instance id>

# Traces / OTLP gateway (metrics+logs+traces over OTLP)
GC_OTLP_URL=https://otlp-gateway-prod-XX.grafana.net/otlp
GC_OTLP_USER=<instance id>

# Profiles (Pyroscope)
GC_PYRO_URL=https://profiles-prod-XX.grafana.net
GC_PYRO_USER=<profiles instance id>

# One Cloud Access Policy token with write scopes for the signals you send
GC_TOKEN=<glc_...>

# vcenter-monitoring (optional). Read Only vSphere user; Statistics Level >= 2.
# Endpoint is https://host or https://host:443 — do not append /sdk.
VCENTER_ENDPOINT=https://vcenter.example.local
VCENTER_USERNAME=readonly@vsphere.local
VCENTER_PASSWORD=

# Fleet Management onboarding (_cloud/remotecfg.alloy).
# Copy URL and username from Fleet Management → Remote configuration.
# GC_FLEET_URL=https://fleet-management-prod-XX.grafana.net
# GC_FLEET_USER=<fleet instance id>
