import.file "grafana_cloud" {
	filename = sys.env("GC_DESTINATIONS_FILE")
}

grafana_cloud.otlp "default" {}
/*
 * Alloy Configuration for OpenTelemetry Trace Collection with Tail Sampling
 */

// Receive OpenTelemetry traces
otelcol.receiver.otlp "default" {
  http {}
  grpc {}

  output {
    traces = [otelcol.processor.tail_sampling.default.input]
  }
}

// Tail Sampling processor
otelcol.processor.tail_sampling "default" {
  decision_wait               = "10s"
  num_traces                  = 100
  expected_new_traces_per_sec = 10
  sample_on_first_match       = true
  decision_cache = {
    sampled_cache_size     = 1000,
    non_sampled_cache_size = 10000,
  }
  
  // Policy 1: Always sample traces with a specific attribute value
  policy {
    name = "test-attribute-policy"
    type = "string_attribute"
    
    string_attribute {
      key    = "test_attr_key_1"
      values = ["test_attr_val_1"]
    }
  }
  
  // Policy 2: Sample error traces
  policy {
    name = "error-policy"
    type = "status_code"
    
    status_code {
      status_codes = ["ERROR"]
    }
  }
  
  // Policy 3: Sample high latency traces
  policy {
    name = "latency-policy"
    type = "latency"
    
    latency {
      threshold_ms = 5000  // 5 seconds
    }
  }
  
  // Policy 4: Sample traces matching a numeric attribute range
  policy {
    name = "numeric-policy"
    type = "numeric_attribute"
    
    numeric_attribute {
      key       = "key1"
      min_value = 70
      max_value = 100
    }
  }
  
  // drop: invert_match is deprecated. Drop traces whose path is a probe.
  policy {
    name = "drop-probes"
    type = "drop"

    drop {
      drop_sub_policy {
        name = "probe-urls"
        type = "string_attribute"

        string_attribute {
          key                    = "http.url"
          values                 = ["/health", "/metrics"]
          enabled_regex_matching = true
        }
      }
    }
  }

  // and: keep only when BOTH error and slow.
  policy {
    name = "slow-errors"
    type = "and"

    and {
      and_sub_policy {
        name = "is-error"
        type = "status_code"

        status_code {
          status_codes = ["ERROR"]
        }
      }

      and_sub_policy {
        name = "is-slow"
        type = "latency"

        latency {
          threshold_ms = 1000
        }
      }
    }
  }

  // ottl_condition: keep login spans by OTTL (the demo app sets http.url=/login).
  policy {
    name = "login-ottl"
    type = "ottl_condition"

    ottl_condition {
      error_mode = "ignore"
      span = [
        `attributes["http.url"] == "/login"`,
      ]
    }
  }

  policy {
    name = "probabilistic-policy"
    type = "probabilistic"

    probabilistic {
      sampling_percentage = 10
    }
  }
  
  output {
    traces = [otelcol.processor.batch.default.input]
  }
}

// Batch processor to improve performance
otelcol.processor.batch "default" {
  output {
    traces = [grafana_cloud.otlp.default.input]
  }
}

// Send sampled traces to Tempo

livedebugging {
  enabled = true
}