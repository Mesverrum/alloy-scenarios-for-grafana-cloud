import.file "grafana_cloud" {
	filename = sys.env("GC_DESTINATIONS_FILE")
}

grafana_cloud.otlp "default" {}
livedebugging {
	enabled = true
}

// Receive OTLP metrics from the demo app
otelcol.receiver.otlp "default" {
	http { }

	grpc { }

	output {
		metrics = [otelcol.processor.filter.drop_noise.input]
	}
}

// Drop probe datapoints before batch/transform. The demo app labels /health
// as an endpoint on app.requests.total.
otelcol.processor.filter "drop_noise" {
	error_mode = "ignore"

	metrics {
		datapoint = [
			`attributes["endpoint"] == "/health"`,
		]
	}

	output {
		metrics = [otelcol.processor.batch.default.input]
	}
}

otelcol.processor.batch "default" {
	output {
		metrics = [otelcol.processor.transform.default.input]
	}
}

// Transform metric attributes (example: add a deployment label)
otelcol.processor.transform "default" {
	error_mode = "ignore"

	metric_statements {
		context    = "resource"
		statements = [
			"set(attributes[\"deployment.environment\"], \"demo\")",
		]
	}

	output {
		metrics = [grafana_cloud.otlp.default.input]
	}
}

// Export metrics to Prometheus via OTLP
