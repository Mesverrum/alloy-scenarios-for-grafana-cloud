// SQL Server metrics → Grafana Cloud
// job label matches the Cloud MSSQL integration dashboard.

import.file "grafana_cloud" {
	filename = sys.env("GC_DESTINATIONS_FILE")
}

livedebugging {
	enabled = true
}

grafana_cloud.metrics "default" {}

local.file "queries" {
	filename = "/etc/alloy/mssql-queries.yaml"
}

prometheus.exporter.mssql "integrations_mssql" {
	connection_string = sys.env("MSSQL_CONNECTION_STRING")
	query_config      = local.file.queries.content
}

discovery.relabel "integrations_mssql" {
	targets = prometheus.exporter.mssql.integrations_mssql.targets

	rule {
		target_label = "job"
		replacement  = "integrations/mssql"
	}

	rule {
		target_label = "instance"
		replacement  = "mssql-monitoring"
	}
}

prometheus.scrape "integrations_mssql" {
	targets         = discovery.relabel.integrations_mssql.output
	forward_to      = [grafana_cloud.metrics.default.receiver]
	// 1m matches Grafana Cloud's 1 data-point-per-minute billing assumption.
	scrape_interval = "1m"
}
