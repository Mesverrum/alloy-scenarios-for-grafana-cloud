// Memcached metrics → Grafana Cloud

import.file "grafana_cloud" {
	filename = sys.env("GC_DESTINATIONS_FILE")
}

livedebugging {
	enabled = true
}

grafana_cloud.metrics "default" {}

prometheus.exporter.memcached "integrations_memcached" {
	address = "memcached:11211"
}

discovery.relabel "integrations_memcached" {
	targets = prometheus.exporter.memcached.integrations_memcached.targets

	rule {
		target_label = "job"
		replacement  = "integrations/memcached"
	}

	rule {
		target_label = "instance"
		replacement  = "memcached-monitoring"
	}
}

prometheus.scrape "integrations_memcached" {
	targets         = discovery.relabel.integrations_memcached.output
	forward_to      = [grafana_cloud.metrics.default.receiver]
	// 1m matches Grafana Cloud's 1 data-point-per-minute billing assumption.
	scrape_interval = "1m"
}
