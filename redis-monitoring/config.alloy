// Redis metrics → Grafana Cloud
// job label matches the Cloud Redis integration dashboard.

import.file "grafana_cloud" {
	filename = sys.env("GC_DESTINATIONS_FILE")
}

livedebugging {
	enabled = true
}

grafana_cloud.metrics "default" {}

prometheus.exporter.redis "integrations_redis" {
	redis_addr = "redis:6379"
}

discovery.relabel "integrations_redis" {
	targets = prometheus.exporter.redis.integrations_redis.targets

	rule {
		target_label = "job"
		replacement  = "integrations/redis"
	}

	rule {
		target_label = "instance"
		replacement  = "redis-monitoring"
	}
}

prometheus.scrape "integrations_redis" {
	targets         = discovery.relabel.integrations_redis.output
	forward_to      = [grafana_cloud.metrics.default.receiver]
	// 1m matches Grafana Cloud's 1 data-point-per-minute billing assumption.
	scrape_interval = "1m"
}
