// Docker cAdvisor metrics + container logs → Grafana Cloud
// Needs the Docker socket (Linux/WSL).

import.file "grafana_cloud" {
	filename = sys.env("GC_DESTINATIONS_FILE")
}

livedebugging {
	enabled = true
}

grafana_cloud.metrics "default" {}
grafana_cloud.logs "default" {}

prometheus.exporter.cadvisor "integrations_docker" {
	docker_only = true
}

discovery.relabel "integrations_docker" {
	targets = prometheus.exporter.cadvisor.integrations_docker.targets

	rule {
		target_label = "job"
		replacement  = "integrations/docker"
	}

	rule {
		target_label = "instance"
		replacement  = constants.hostname
	}
}

prometheus.scrape "integrations_docker" {
	targets    = discovery.relabel.integrations_docker.output
	forward_to = [grafana_cloud.metrics.default.receiver]
	// 1m matches Grafana Cloud's 1 data-point-per-minute billing assumption.
	// OSS used 10s (6x DPM) — do not restore that for a Cloud POV.
	scrape_interval = "1m"
}

discovery.docker "linux" {
	host = "unix:///var/run/docker.sock"
}

discovery.relabel "logs_integrations_docker" {
	targets = []

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "container_name"
	}

	rule {
		target_label = "instance"
		replacement  = constants.hostname
	}

	rule {
		target_label = "job"
		replacement  = "integrations/docker"
	}
}

loki.source.docker "default" {
	host          = "unix:///var/run/docker.sock"
	targets       = discovery.docker.linux.targets
	relabel_rules = discovery.relabel.logs_integrations_docker.rules
	forward_to    = [loki.process.docker_logs.receiver]
}

loki.process "docker_logs" {
	forward_to = [grafana_cloud.logs.default.receiver]

	stage.drop {
		source     = "container_name"
		expression = "(alloy)"
	}
}
