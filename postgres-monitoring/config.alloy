// PostgreSQL metrics → Grafana Cloud
// job label matches the Cloud PostgreSQL integration dashboard.

import.file "grafana_cloud" {
	filename = sys.env("GC_DESTINATIONS_FILE")
}

livedebugging {
	enabled = true
}

grafana_cloud.metrics "default" {}

prometheus.exporter.postgres "integrations_postgres_exporter" {
	data_source_names = ["postgresql://alloy:alloy@postgres:5432/alloy?sslmode=disable"]
	// Auth alternatives: sslmode=require (or verify-full) + a CA on the DSN.
	// Docs extras (uncomment when the DB has the extension / extra databases):
	// enabled_collectors = ["stat_statements"]
	// autodiscovery {
	//   enabled            = true
	//   database_allowlist = ["alloy"]
	// }
}

discovery.relabel "integrations_postgres_exporter" {
	targets = prometheus.exporter.postgres.integrations_postgres_exporter.targets

	rule {
		target_label = "job"
		replacement  = "integrations/postgres_exporter"
	}

	rule {
		target_label = "instance"
		replacement  = "postgres-monitoring"
	}
}

prometheus.scrape "integrations_postgres_exporter" {
	targets         = discovery.relabel.integrations_postgres_exporter.output
	forward_to      = [grafana_cloud.metrics.default.receiver]
	// 1m matches Grafana Cloud's 1 data-point-per-minute billing assumption.
	scrape_interval = "1m"
}
